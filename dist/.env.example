# autopilot 0.9.x — 环境变量样例（纯占位，不含任何真实值 / 地址 / 密钥）
# =============================================================================
# 用法：复制本文件到你自己的环境文件里（不要复制进 git 跟踪的项目目录），
#       填好后 `set -a; . <你的env文件>; set +a`，或直接写进宿主的环境配置。
# 规则：所有项**都可以留空**。留空的后果逐条写在各自注释里，没有一项是"必须填才能跑"。
# 安全：本文件不得出现真实令牌、真实 Webhook 地址、真实主目录路径。
#       需要路径时一律用占位符 {SKILL_ROOT} / {REPO_ROOT} / {AUTOPILOT_HOME}。
# =============================================================================

# AUTOPILOT_HOME —— 跨项目状态目录（目标队列 queue/ 与跨项目记忆 playbook.md）的位置。
# 填法：一个绝对路径，替换 {AUTOPILOT_HOME}；建议放在你自己的备份/同步策略覆盖范围内。
# 留空后果：程序回退到"用户主目录下的默认位置"。注意当前实现里只有队列认这个变量
#           （scripts/queue.py:22），跨项目记忆仍走固定主目录路径（scripts/playbook.py:18），
#           两者不一致是本包已知限制，待 0.9 正式版统一。
AUTOPILOT_HOME=

# AUTOPILOT_SKILL_ROOTS —— 技能扫描根列表（发现本机可用技能/MCP/智能体的目录集合）。
# 填法：多个目录用冒号分隔（POSIX 路径分隔约定），例如 {SKILL_ROOT} 的父目录；
#       设置后会**整体替换**源码里的默认列表（scripts/discover.py:20 起为待外置的硬编码常量）。
# 注意：冒号分隔与 Windows 盘符冲突，原生 Windows 不在承诺范围（见 dist/cross-platform.md）。
# 留空后果：使用源码内置的默认扫描根——它们写的是"某工具的用户级技能目录"名字，
#           在你的机器上可能一个都不存在，结果是能力索引为空、任务卡的能力段只能写"无"，
#           开发照常进行，只是失去技能匹配（这是可降级项，不是致命错误）。
AUTOPILOT_SKILL_ROOTS=

# AUTOPILOT_WEBHOOK —— 长跑进度通知的接收地址（飞书 / Slack / 任意自建 hook）。
# 填法：你自己配置的地址，只推给你本人；本包不向任何第三方发送内容。
# 留空后果：**通知功能完全关闭**（默认即关闭）。notify.sh 不发出任何网络请求，
#           长跑状态只看 .autopilot/ 下的落盘文件与 status.py summary。
# 提醒：这里填的内容等于凭证，别提交进版本库，也别贴进任务卡或提示词。
AUTOPILOT_WEBHOOK=

# AUTOPILOT_HASH_IMPL —— sha256 计算实现的选择。
# 取值：auto | shasum | sha256sum | python
#   auto（默认）：按 shasum -a 256 → sha256sum → python3 hashlib 顺序探测，
#                 结果写进 {REPO_ROOT}/.autopilot/env.json 供后续脚本复用。
#   其余值：强制指定一种，用于排查"同一 manifest 在两处算出不同文本"的问题（元验收 M7）。
# 留空后果：等价于 auto。若三种实现全都不存在（极端精简镜像），freeze/verify 直接失败并提示，
#           不会静默跳过校验——判定侧不允许"算不了就当没改"。
AUTOPILOT_HASH_IMPL=auto

# AUTOPILOT_HOST —— Host Adapter 名称，对应 specs/host-adapter.md 里的 5 原语映射表。
# 填法：填你的宿主在 .autopilot/host.json 中登记的 adapter 名（当前唯一经过实测的映射见
#       specs/host-adapter.md:20；其他后端名属于"接口已定义、真机未验证"）。
# 留空后果：按 generic-cli（只有本地命令、无会话原语）的最保守形态处理：
#           同会话顺序轮 + 每轮强制落盘 + 每轮开头只读接续包，不并行，
#           且 REPORT 必须声明降级项（intercept_permission absent → 元验收 M11）。
AUTOPILOT_HOST=

# AUTOPILOT_TOKEN_BUDGET —— 令牌预算（可选指标）。
# 填法：一个正整数；不填 = 完全不参与停止判定。
# 留空后果：**这是默认且推荐状态**。脚本层无法自观测宿主模型的令牌消耗，
#           把它写进停止条件只会产生一个假指标（升级裁决 §2 已据此把它降级）。
#           真正的停止条件仍是：验收全绿 / 连续两轮零进展 / 轮次·调用数·时长预算耗尽。
#           填了也只作为 REPORT 里的参考数字，不触发停机。
AUTOPILOT_TOKEN_BUDGET=

# AUTOPILOT_MAX_PARALLEL_WORKERS —— 同一波次内并行派发的工人上限。
# 填法：正整数。实际并行度 = min(本值, state.json 的 budget.parallel, host.json 的 parallel_workers)。
# 留空后果：只用 init.sh 的 --parallel 默认值（3）。若 host.json 声明宿主无并行原语，
#           无论这里填什么都自动退化为串行——这是能力边界，不是配置能突破的。
# 提醒：并行只允许在"写集互不重叠"的任务之间发生，与额度无关。
AUTOPILOT_MAX_PARALLEL_WORKERS=
